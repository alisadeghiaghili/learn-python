[
  {
    "id": "arithmetic-precedence",
    "note": "+ * - precedence",
    "source": "x = 2 + 3 * 4 - 1\nprint(x)",
    "expected": { "kind": "ok", "text": "13" },
    "expect": "parity"
  },
  {
    "id": "int-div-mod-pow",
