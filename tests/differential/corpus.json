  {
    "id": "drift-iadd",
    "note": "CPython list.__iadd__ extends in place, so the alias b sees [1, 2]; the simulator rebinds a to a new list, so b stays [1]. (Phase 3: __iadd__/__imul__)",
    "source": "a = [1]\nb = a\na += [2]\nprint(b)",
    "expected": { "kind": "ok", "text": "[1, 2]" },
    "expect": "drift"
  },
  {
    "id": "drift-unbound",
    "note": "CPython pre-scopes x as local inside bump() (assigned, not declared global), so reading x before that assignment raises UnboundLocalError. The simulator has no local pre-scope (lookupName walks all frames), so the read falls through to the module x and prints 1. (Phase 2: scope)",
    "source": "x = 1\ndef bump():\n    print(x)\n    x = 2\nbump()",
    "expected": { "kind": "exc", "excType": "UnboundLocalError" },
    "expect": "drift"
  }
]
